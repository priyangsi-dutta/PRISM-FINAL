# ==============================================================================
# PRism — Configuration Environment Variables
# ==============================================================================
# Copy this file to '.env' and fill in the values appropriate for your environment.
# Never commit real API keys, tokens, or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Configuration
# ------------------------------------------------------------------------------
# Base URL pointing to the PRism FastAPI triage backend.
# In local development with Vite dev server (npm run dev), Vite proxies /api to
# http://localhost:8000 by default. Set this if your backend runs on a different port/host.
VITE_API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 2. GitHub REST API Configuration (Backend)
# ------------------------------------------------------------------------------
# Optional: GitHub Personal Access Token (classic or fine-grained).
# Providing a token increases the GitHub API rate limit from 60 requests/hr (unauthenticated)
# to 5,000 requests/hr, and enables analysis of private repositories your account can access.
# If left blank, PRism operates in unauthenticated mode for public pull requests.
GITHUB_TOKEN=

# ------------------------------------------------------------------------------
# 3. AI Service Provider Configuration (Optional)
# ------------------------------------------------------------------------------
# PRism works completely deterministically using its built-in rule engine even if no AI
# provider is configured. To optionally enable AI-generated executive summaries and checklists,
# configure one of the following provider keys:

# Option A: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Option B: Anthropic
ANTHROPIC_API_KEY=

# Option C: Google Gemini
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 4. Server Configuration
# ------------------------------------------------------------------------------
PORT=8000
HOST=127.0.0.1

